{
  "name": "ap-life-quest",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "fflate": "0.8.3",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "description": "AP Life Quest — a cute pixel-RPG life tracker (quests, calories, weight, goals, rewards)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "db:migrate:local": "wrangler d1 migrations apply ap-life-quest-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ap-life-quest-db --remote",
    "deploy": "npm run check && vite build && wrangler d1 migrations apply ap-life-quest-db --remote && wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "set-password": "node scripts/set-password.mjs",
    "setup-2fa": "node scripts/setup-2fa.mjs",
    "backup": "node scripts/backup.mjs",
    "versions": "wrangler deployments list",
    "rollback": "wrangler rollback",
    "icons": "node scripts/make-icons.mjs",
    "test:api": "node tests/api-regression.mjs",
    "reset-owner": "node scripts/reset-owner.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
