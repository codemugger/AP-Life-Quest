{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ap-life-quest",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Static files (the game UI) are served directly; only /api/* runs the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ap-life-quest-db",
      // Filled in by `npm run setup` (scripts/setup.mjs). Any value works for local dev.
      "database_id": "5cace10f-379e-42f3-be84-891e3b3c56bd",
      "migrations_dir": "migrations"
    }
  ]
}
