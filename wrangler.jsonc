{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ap-life-quest",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Static files (the game UI) are served directly; only /api/* runs the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // v2: every character is its own Durable Object with a private SQLite database.
  "durable_objects": {
    "bindings": [{ "name": "CHAR", "class_name": "CharacterDO" }]
  },
  "migrations": [{ "tag": "v1-characters", "new_sqlite_classes": ["CharacterDO"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ap-life-quest-db",
      // Filled in by `npm run setup` (scripts/setup.mjs). Any value works for local dev.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
